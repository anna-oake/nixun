Use the big-endian 0..2047 brightness range from Xiaomi’s M84 36 panel
configuration. The DCS helper already sends the high byte first.

--- a/drivers/gpu/drm/panel/panel-xiaomi-m84-36-02-0a.c
+++ b/drivers/gpu/drm/panel/panel-xiaomi-m84-36-02-0a.c
@@ -292,13 +292,12 @@
 	u16 brightness = backlight_get_brightness(bl);
 	if (!brightness)
 		brightness = 1;
-	u16 level = brightness << 1;
 
 	/* Coalesce the stream of values a brightness slider produces.  Each
 	 * DCS write briefly disturbs the video stream, so send only the value
 	 * the slider settles on instead of one command per step.
 	 */
-	ctx->bl_value = ((level >> 4) << 8) | (level & 0xf);
+	ctx->bl_value = brightness;
 	if (ctx->prepared)
 		mod_delayed_work(system_wq, &ctx->bl_work, msecs_to_jiffies(150));
 	return 0;
