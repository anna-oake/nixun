+++ b/sound/soc/codecs/wcd937x.c
@@ -10,6 +10,7 @@
 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
+#include <linux/pm_runtime.h>
 #include <linux/regmap.h>
 #include <linux/regulator/consumer.h>
 #include <linux/slab.h>
@@ -2708,11 +2709,34 @@
 	default:
 		break;
 	}
+
+	return 0;
+}
+
+static int wcd937x_codec_startup(struct snd_pcm_substream *substream,
+				struct snd_soc_dai *dai)
+{
+	struct wcd937x_priv *wcd937x = snd_soc_component_get_drvdata(dai->component);
+
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
+		/* The RX SoundWire slave must be awake for the ADC to deliver data. */
+		return pm_runtime_resume_and_get(wcd937x->rxdev);
 
 	return 0;
 }
 
+static void wcd937x_codec_shutdown(struct snd_pcm_substream *substream,
+				  struct snd_soc_dai *dai)
+{
+	struct wcd937x_priv *wcd937x = snd_soc_component_get_drvdata(dai->component);
+
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
+		pm_runtime_put_autosuspend(wcd937x->rxdev);
+}
+
 static const struct snd_soc_dai_ops wcd937x_sdw_dai_ops = {
+	.startup = wcd937x_codec_startup,
+	.shutdown = wcd937x_codec_shutdown,
 	.hw_params = wcd937x_codec_hw_params,
 	.hw_free = wcd937x_codec_free,
 	.set_stream = wcd937x_codec_set_sdw_stream,
