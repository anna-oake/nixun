+static int xun_parse_abl_memory(const void *fdt)
+{
+	const void *abl_fdt;
+	const fdt64_t *reg;
+	int node, len, i;
+	u64 start, size;
+
+	if (fdt_node_check_compatible(fdt, 0, "xiaomi,xun"))
+		return -ENODATA;
+
+	abl_fdt = (const void *)get_xun_abl_fdt_addr();
+	if (!abl_fdt || fdt_check_header(abl_fdt) ||
+	    fdt_address_cells(abl_fdt, 0) != 2 || fdt_size_cells(abl_fdt, 0) != 2)
+		return -ENODATA;
+
+	node = fdt_path_offset(abl_fdt, "/memory");
+	if (node < 0)
+		return -ENODATA;
+
+	reg = fdt_getprop(abl_fdt, node, "reg", &len);
+	if (!reg || len <= 0 || len % (2 * sizeof(*reg)) ||
+	    len > 2 * sizeof(*reg) * CONFIG_NR_DRAM_BANKS)
+		return -ENODATA;
+
+	for (i = 0; i < len / sizeof(*reg); i += 2) {
+		start = get_unaligned_be64(&reg[i]);
+		size = get_unaligned_be64(&reg[i + 1]);
+		if (!size || start + size < start)
+			return -ENODATA;
+	}
+
+	return qcom_parse_memory(abl_fdt);
+}
